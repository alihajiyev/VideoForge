# VideoForge ortam degiskenleri - bu dosyayi ".env" olarak kopyalayip doldurun.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env dosyasi .gitignore icindedir; anahtarlar repoya ASLA girmez.
#
# Bulutta (Modal) ayni degerler modal.Secret.from_dotenv() ile ortam degiskeni
# olarak enjekte edilir - imaja gomulmez.

# Gemini API anahtarlari (AI Studio). Virgulle ayrilir; sira = kota onceligi.
# Flash Lite ailesi gunluk 500 istek, Flash ailesi 20 istek.
GEMINI_API_KEYS=key1,key2,key3

# ElevenLabs seslendirme anahtari
ELEVENLABS_API_KEY=

# transcriptapi.com anahtari (ucretsiz altyazi yedegi)
TRANSCRIPT_API_KEY=

# ZapCap (altyazi/efekt) - uygulamadan da degistirilebilir (Ayarlar > API anahtarlari).
# ZapCap anahtari/sablonu ayni zamanda ShortsStudio functions/config.py'ye de yazilir.
ZAPCAP_API_KEY=
ZAPCAP_TEMPLATE_ID=

# Altyazi motoru: auto | zapcap | yerel | remotion
#   auto     = mevcut davranis (3. kanal yerel karaoke, digerleri ZapCap)
#   zapcap   = her kanal ZapCap sablonuyla
#   yerel    = her kanal ucuz yerel karaoke altyazi
#   remotion = karaoke kompozit Remotion ile
ALTYAZI_MOTORU=auto

# Kanal sesleri (ElevenLabs voice ID). Bos birakilirsa bottaki sabit varsayilan kullanilir.
VOICE_ID_CH1=
VOICE_ID_CH2=
VOICE_ID_CH3=
