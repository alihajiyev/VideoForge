# VideoForge ortam degiskenleri - bu dosyayi ".env" olarak kopyalayip doldurun.
#   cp .env.example .env        (Windows: copy .env.example .env)
# .env dosyasi .gitignore icindedir; anahtarlar repoya ASLA girmez.
#
# Bulutta (Modal) ayni degerler modal.Secret.from_dotenv() ile ortam degiskeni
# olarak enjekte edilir - imaja gomulmez.

# Gemini API anahtarlari (AI Studio). Virgulle ayrilir; sira = kota onceligi.
# Flash Lite ailesi gunluk 500 istek, Flash ailesi 20 istek.
GEMINI_API_KEYS=key1,key2,key3

# ElevenLabs seslendirme anahtari
ELEVENLABS_API_KEY=

# transcriptapi.com anahtari (ucretsiz altyazi yedegi)
TRANSCRIPT_API_KEY=
